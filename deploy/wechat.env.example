# 微信支付兼容配置示例（Sep01V1 界面暂时停用；不要把真实私钥内容写进本文件）
# 公共商户：A/B 共用一个 mchid
WECHAT_MCH_ID=
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/apiclient_key.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/pub_key.pem

WECHAT_AUTO_SYNC=true
WECHAT_SYNC_HOUR=10
WECHAT_SYNC_MINUTE=10
WECHAT_TIMEZONE=Asia/Shanghai
WECHAT_AMOUNT_MODE=order
WECHAT_DATASET_ID=

# 同商户号分店方式：填写交易账单里的 device_id；多个用英文逗号分隔。
WECHAT_A_DEVICE_IDS=
WECHAT_B_DEVICE_IDS=
WECHAT_UNMATCHED_STORE=ERROR

# 如果 A/B 店分别拥有独立商户号，可改用下面两组 WECHAT_A_* / WECHAT_B_*，
# 此时上方公共 WECHAT_* 商户凭据不会用于分店账单。
# WECHAT_A_MCH_ID=
# WECHAT_A_MERCHANT_SERIAL_NO=
# WECHAT_A_PRIVATE_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/a/apiclient_key.pem
# WECHAT_A_PUBLIC_KEY_ID=
# WECHAT_A_PUBLIC_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/a/pub_key.pem
# WECHAT_B_MCH_ID=
# WECHAT_B_MERCHANT_SERIAL_NO=
# WECHAT_B_PRIVATE_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/b/apiclient_key.pem
# WECHAT_B_PUBLIC_KEY_ID=
# WECHAT_B_PUBLIC_KEY_PATH=/opt/restaurant-cloud/secrets/wechat/b/pub_key.pem
